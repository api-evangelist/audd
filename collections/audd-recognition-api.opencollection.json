{
  "opencollection": "1.0.0",
  "info": {
    "name": "AudD Music Recognition API",
    "version": "1.4.4"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_token",
      "value": "{{api_token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Recognition",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Same as POST recognize, but with parameters in the query string",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.audd.io/",
            "params": [
              {
                "name": "api_token",
                "value": "",
                "type": "query"
              },
              {
                "name": "url",
                "value": "",
                "type": "query"
              },
              {
                "name": "return",
                "value": "",
                "type": "query"
              },
              {
                "name": "market",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "GET form of `/`. Useful for quick tests in a browser; POST is preferred."
        },
        {
          "info": {
            "name": "Identify a song from an audio clip (the first 12 seconds are analyzed; ≤10 MB)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.audd.io/",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "api_token",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "url",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "audio",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "return",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "market",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Standard music recognition. Send a file directly (multipart) or pass\na URL the AudD server downloads.\n\nOnly the first 12 seconds of the audio are analyzed. To recognize music\nbeyond the first 12 seconds of a file, use the enterprise endpoint\n(`POST https://enterprise.audd.io/`), which scans the whole file."
        },
        {
          "info": {
            "name": "Recognize music in large audio/video files (hours- or days-long)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.audd.io/enterprise/",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "api_token",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "url",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "file",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "return",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "accurate_offsets",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "skip",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "every",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "limit",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "skip_first_seconds",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "use_timecode",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "response_type",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Enterprise endpoint. Send an HTTPS URL or a multipart file (streamed,\nno in-memory buffering needed). The endpoint chunks the audio into\n12-second segments and counts each scanned chunk as 1 request.\n\nSDKs default to a 1-hour read timeout for this endpoint and enable TCP\nkeepalive on the transport."
        }
      ]
    }
  ],
  "bundled": true
}