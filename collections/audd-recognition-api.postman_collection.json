                  "disabled": false,
                  "key": "return",
                  "value": "<string>",
                  "description": "Comma-separated list of additional metadata providers to include, e.g. `apple_music,spotify,deezer,napster,musicbrainz`."
                },
                {
                  "disabled": false,
                  "key": "market",
                  "value": "us",
                  "description": "Two-letter country code for Apple Music / iTunes / Spotify results."
                }
              ]
