  "info": {
    "_postman_id": "8ea05839-47af-437a-8a54-004358763384",
    "name": "AudD Music Lyrics Recognition API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "AudD is a music recognition service. The API identifies songs from an uploaded audio file, a remote audio/video URL, or base64-encoded audio and returns rich track metadata. It also supports recognition with offset (including humming/singing) and lyrics search. All methods authenticate with an `api_token` and accept either form-encoded or multipart/form-data input.\n\nContact Support:\n Name: AudD Support\n Email: api@audd.io",
      "type": "text/plain"
    }
  }
