        {
          "id": "25d5e2bc-7264-4ab5-a59c-816b8928277b",
          "name": "Recognize music in large audio/video files (hours- or days-long)",
          "request": {
            "name": "Recognize music in large audio/video files (hours- or days-long)",
            "description": {
              "content": "Enterprise endpoint. Send an HTTPS URL or a multipart file (streamed,\nno in-memory buffering needed). The endpoint chunks the audio into\n12-second segments and counts each scanned chunk as 1 request.\n\nSDKs default to a 1-hour read timeout for this endpoint and enable TCP\nkeepalive on the transport.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "enterprise",
                ""
              ],
              "host": [
                "enterprise",
                "audd",
                "io"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "api_token",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "url",
                  "value": "<uri>",
                  "type": "text",
                  "description": ""
                },
                {
                  "key": "file",
                  "type": "file",
                  "description": ""
                },
                {
                  "key": "return",
                  "value": "<string>",
                  "type": "text",
                  "description": "Comma-separated metadata identifiers. Same as the standard\nendpoint — but **Spotify is NOT supported** on enterprise.\n"
                },
                {
                  "key": "accurate_offsets",
                  "value": "<string>",
                  "type": "text",
                  "description": "When 'true', return per-match start/end offsets within each 12-second chunk. (This can only be one of true,false)"
                },
                {
                  "key": "skip",
                  "value": "<integer>",
                  "type": "text",
                  "description": "Number of 12-second chunks to skip after each scanned chunk."
                },
                {
                  "key": "every",
                  "value": "<integer>",
                  "type": "text",
                  "description": "Number of consecutive chunks to scan."
                },
                {
                  "key": "limit",
                  "value": "<integer>",
                  "type": "text",
                  "description": "Upper bound on the number of chunks to recognize. **Always\nset this in dev/test environments to control cost.**\n"
                },
                {
                  "key": "skip_first_seconds",
                  "value": "<integer>",
                  "type": "text",
                  "description": ""
                },
                {
                  "key": "use_timecode",
                  "value": "<string>",
                  "type": "text",
                  "description": "When 'true', use the `t`/`time_continue`/`start` URL parameter\nof the source URL as `skip_first_seconds`. Mutually exclusive\nwith `skip_first_seconds`.\n (This can only be one of true,false)"
                },
                {
                  "key": "response_type",
                  "value": "<string>",
                  "type": "text",
                  "description": "Output format. Default json. (This can only be one of json,csv)"
                }
              ]
            }
          },
