          "name": "Recognize music from a file, URL, or base64 audio",
          "request": {
            "name": "Recognize music from a file, URL, or base64 audio",
            "description": {
              "content": "Identifies a song from a short audio sample. Provide the audio as a multipart file upload, a remote `url`, or a base64-encoded `audio` string. Returns matched track metadata and, optionally, links to streaming services.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
