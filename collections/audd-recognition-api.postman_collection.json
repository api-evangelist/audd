          "id": "cfae2191-729c-431d-9a73-87aeca48c598",
          "name": "Identify a song from an audio clip (the first 12 seconds are analyzed; ≤10 MB)",
          "request": {
            "name": "Identify a song from an audio clip (the first 12 seconds are analyzed; ≤10 MB)",
            "description": {
              "content": "Standard music recognition. Send a file directly (multipart) or pass\na URL the AudD server downloads.\n\nOnly the first 12 seconds of the audio are analyzed. To recognize music\nbeyond the first 12 seconds of a file, use the enterprise endpoint\n(`POST https://enterprise.audd.io/`), which scans the whole file.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                ""
              ],
              "host": [
                "api",
                "audd",
                "io"
