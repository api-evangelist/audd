          "id": "397891c2-3843-468e-a632-ee925e75ca1f",
          "name": "Add a song to the caller's private fingerprint catalog (NOT for music…",
          "request": {
            "name": "Add a song to the caller's private fingerprint catalog (NOT for music…",
            "description": {
              "content": "⚠ **This is NOT how you submit audio for music recognition.** For\nrecognition, use `POST /` (or `POST enterprise.audd.io/` to scan\nbeyond the first 12 seconds of a file). This endpoint adds a song to the caller's\nprivate fingerprint catalog so AudD can later identify it for the\ncaller's account only.\n\nRequires special access — contact api@audd.io to enable.\n\nCalling `upload` again with the same `audio_id` re-fingerprints that\nslot. There is no public list/delete endpoint; callers track\n`audio_id` ↔ song mappings on their side.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "upload",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "api_token",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) "
                },
                {
                  "key": "audio_id",
                  "value": "<integer>",
                  "type": "text",
                  "description": "(Required) Caller-supplied identifier returned alongside future\nrecognition results when this song is matched.\n"
                },
                {
                  "key": "url",
                  "value": "<uri>",
                  "type": "text",
                  "description": "One of `url` or `file` is required."
                },
